{
  "name": "budget-buddy",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "backend": "npm --prefix backend run server",
    "frontend": "npm --prefix frontend run dev",
    "dev": "concurrently \"npm --prefix backend run server\" \"npm --prefix frontend run dev\"",
    "install:backend": "npm --prefix backend install",
    "install:frontend": "npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
